// /api/chat.js
import fetch from "node-fetch";

export default async function handler(req, res) {
    if (req.method !== "POST") {
        return res.status(405).json({ error: "Method not allowed" });
    }

    try {
        const { message, feature } = req.body;

        if (!message || !feature) {
            return res.status(400).json({ error: "Message and feature are required" });
        }

        // Feature contexts (same as frontend)
        const features = {
            notes: "You are an AI study assistant specialized in creating concise, well-structured study notes. Help students summarize topics, highlight key points, and organize information clearly. Format responses with bullet points or short paragraphs when helpful. Keep answers focused and educational.",
            homework: "You are an AI tutor that provides step-by-step solutions to academic problems. Break down complex questions into clear, logical steps. Explain reasoning thoroughly. Cover subjects like math, science, and programming. Always show the process.",
            flashcards: "You are an AI flashcard generator. Create Q&A style flashcards for effective exam preparation. Format responses as question-answer pairs or concise key facts. Help students memorize definitions, formulas, and concepts.",
            brain: "You are an AI that creates engaging brain teasers, riddles, logic puzzles, and fun educational games. Challenge students while keeping learning enjoyable. Provide hints and explain answers playfully.",
            formula: "You are an AI formula expert. Provide key formulas, derivations, and concept summaries for various subjects (math, physics, chemistry). Organize formulas clearly with explanations. Help students revise quickly."
        };

        const systemContext = features[feature] || "";

        // Call OpenRouter API
        const apiKey = process.env.OPENROUTER_API_KEY; // set in Vercel env
        if (!apiKey) return res.status(500).json({ error: "API key not configured" });

        const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${apiKey}`,
                "HTTP-Referer": req.headers.origin || ""
            },
            body: JSON.stringify({
                model: "openai/gpt-3.5-turbo",
                messages: [
                    { role: "system", content: systemContext },
                    { role: "user", content: message }
                ],
                temperature: 0.7,
                max_tokens: 800
            })
        });

        if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            return res.status(response.status).json({ error: errData.error?.message || "OpenRouter API error" });
        }

        const data = await response.json();
        const aiReply = data.choices[0].message.content;

        res.status(200).json({ reply: aiReply });

    } catch (error) {
        console.error("Backend error:", error);
        res.status(500).json({ error: error.message || "Internal server error" });
    }
}
